ANTHROPIC_API_KEY=sk-ant-your-key-here
ADMIN_PASSWORD=your-admin-password-here

# Optional but strongly recommended — eliminates Anthropic search rate limits.
# Sign up free at https://app.tavily.com (1000 searches/month on free tier).
# When set, searches run via Tavily and Claude is used only for extraction.
TAVILY_API_KEY=tvly-your-key-here
